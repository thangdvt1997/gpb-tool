# Dockerfile-specific ignore cho docker/auth.Dockerfile.
# BuildKit dùng file này thay cho .dockerignore của context (services/auth).
# Chỉ loại thư mục data ở gốc context, không loại src/data nếu có mã nguồn ở đó.
node_modules
**/node_modules
data
*.db
*.db-*
*.sqlite*
*.log
.env
.env.*
!.env.example
.git
