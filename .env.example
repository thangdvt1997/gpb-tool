# Mẫu biến môi trường cho docker-compose.yml.
# Trên máy chủ: sao chép thành $REMOTE_DIR/.env rồi điền giá trị thật.
# Nếu không có file .env, Compose dùng giá trị mặc định trong docker-compose.yml.
# Không ghi secret thật vào file mẫu này và không commit file .env.

# auth
MAIL_MODE=log
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:18080

# SMTP, chỉ dùng khi MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Đăng nhập Google và Microsoft. Để trống khi chưa có client ID/secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
